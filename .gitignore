# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Environment files: these hold keys and must never be committed.
# .env.example (with placeholder values only) is the one exception.
.env
.env.*
!.env.example

# Vercel
.vercel/

# Supabase CLI local state (migrations in supabase/migrations ARE committed)
supabase/.branches/
supabase/.temp/

# Database dumps can contain real user data
*.sql.gz
*-backup.sql
*.dump

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Editors
.vscode/
.idea/
