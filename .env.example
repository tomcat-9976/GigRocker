# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git; never commit real keys.
#
# Usually: the local Supabase. Run `supabase start` (or `supabase status`)
# and copy its "Project URL" and "Publishable" key here.
#
# Alternatively, staging: the staging project's URL and anon key, from the
# "Connect" button in the Supabase dashboard. Never production's.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_paste-the-local-key-here
