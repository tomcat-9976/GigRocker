# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git; never commit real keys.
#
# For local development, use the STAGING Supabase project's values,
# never production's. Find them with the "Connect" button at the top
# of the Supabase dashboard while the staging project is selected.

NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
